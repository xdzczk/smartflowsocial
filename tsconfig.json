{
  "exclude": ["./tests/e2e", "./node_modules", "**/node_modules/**"],
  "include": [
    "remix.env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "app/types/**/*.d.ts",
    "app/types/**/*.ts",
    "server.ts",
    "worker.ts",
    "prisma/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "vitest.config.ts",
    "cypress.config.ts"
  ],
  "compilerOptions": {
    // Modern lib support
    "lib": ["DOM", "DOM.Iterable", "ES2022", "ES2023"],

    // Module system
    // Note: Using "node" resolution for Remix compatibility
    // "bundler" requires module: "preserve" or ESM, "node16" requires module: "Node16"
    // Remix may require CommonJS, so we keep "node" resolution for compatibility
    "module": "CommonJS",
    "moduleResolution": "node",

    // Target
    "target": "ES2020",

    // JSX
    "jsx": "react-jsx",

    // Strict mode (enables all strict checks)
    "strict": true,

    // Additional strict flags (world-class safety)
    "noUncheckedIndexedAccess": true, // ✅ Critical: Prevents undefined array access
    "noImplicitOverride": true, // ✅ Critical: Requires explicit override keyword
    "noPropertyAccessFromIndexSignature": true, // ✅ Critical: Requires bracket notation for index signatures

    // Module interop
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,

    // Path mappings
    "baseUrl": ".",
    "paths": {
      "~/*": ["./app/*"],
      "~/tests/*": ["./tests/*"]
    },

    // File handling
    "resolveJsonModule": true,
    "allowJs": true,
    "forceConsistentCasingInFileNames": true,

    // Performance
    "skipLibCheck": true,
    "incremental": true, // Enable incremental compilation for faster builds and CI caching

    // Remix takes care of building everything in `remix build`.
    "noEmit": true
  }
}
