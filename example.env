DATABASE_URL=
# Test database URL (optional - uses DATABASE_URL if not set)
TEST_DATABASE_URL=
SESSION_SECRET=
# Nostr publisher: https://github.com/getAlby/http-nostr-publisher
NOSTR_PUBLISHER_URL=
# Primal caching: https://github.com/PrimalHQ/primal-caching-service
# Supports single endpoint or comma-separated list: wss://cache1.example.com/v1,wss://cache2.example.com/v1
# If not set, uses default fallback endpoints
PRIMAL_CACHING_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET=
STORAGE_REGION=
STORAGE_BUCKET=
REDIS_URL=
OWNER_NWC=
NODE_ENV=development
NOSTR_NSEC=
# Sentry error tracking (optional)
# Get your DSN from https://sentry.io/settings/YOUR_ORG/projects/YOUR_PROJECT/keys/
SENTRY_DSN=
# Security configuration (CSRF protection)
# Canonical app URL - used for CSRF origin validation
APP_URL=http://localhost:3000
# Comma-separated list of allowed origins for CSRF protection
# Example: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=
# Metrics endpoint security
# Token required to access /metrics endpoint (recommended for production)
METRICS_TOKEN=
# Comma-separated list of allowed IPs for metrics endpoint (optional, alternative to token)
# Example: 127.0.0.1,10.0.0.0/8
METRICS_ALLOWED_IPS=