generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String         @id @default(cuid())
  npub                       String         @unique
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt
  isEnabled                  Boolean        @default(false)
  timezone                   String?        @default("Etc/GMT")
  userRelays                 String[]       @default(["wss://relay.bullishbounty.com", "wss://relay.snort.social", "wss://relay.primal.net", "wss://relay.damus.io", "wss://relay.nostr.band"])
  giveawayBlackListed        String[]       @default([])
  uploadProvider             UploadProvider @default(S3)
  customBlossomUrl           String?
  showHashTagsinPosts        Boolean        @default(false)
  scheduleInterval           String[]       @default(["0.25", "0.5", "1", "2", "4", "12", "24"])
  nostrProfile               Json?
  enableMirrorBlossom        Boolean        @default(false)
  mirrorUploadUrls           String[]       @default([])
  encryptedNwc               String?
  nwcEnabled                 Boolean        @default(false)
  nwcLastUsed                DateTime?
  mutedList                  Json?
  filterMuted                Boolean        @default(false)
  hidePostsFromLowTrustUsers Boolean        @default(false)
  // Push notification preferences
  pushNotificationsEnabled   Boolean        @default(true)
  pushNotifyPublishSuccess   Boolean        @default(true)
  pushNotifyPublishFailure   Boolean        @default(true)
  pushNotifyRunwayLow        Boolean        @default(false)
  pushNotifyIncludePreview   Boolean        @default(true)
  runwayNotifyBelowDays      Int?
  lastRunwayLowNotificationAt DateTime?
  // Time format preference (12-hour AM/PM or 24-hour)
  timeFormat                 String?        @default("24h") // "12h" or "24h"
  // Date format preference for display (dd/mm, mm/dd, or yyyy-mm-dd)
  dateFormat                 String?        @default("ddmmyyyy") // "ddmmyyyy" | "mmddyyyy" | "yyyymmdd"
  // Preferred Nostr client for "View note/article" links (PRIMAL, DAMUS, AMETHYST, NOSTUR, NOSTRUDEL, IRIS, YAKIHONNE, JUMBLE, CUSTOM)
  preferredNostrClient      String?         @default("PRIMAL")
  // Base URL when preferredNostrClient is CUSTOM (e.g. https://example.com)
  customNostrClientBaseUrl   String?
  // Set when we applied device locale for time/date once (so we never overwrite again)
  localeDefaultsAppliedAt    DateTime?
  // Runway KPI: which queues count and mode (last-post vs first-queue-empty)
  runwaySettings             Json?
  // Account-level preferred NIP-46 signer profile (non-secret metadata only)
  primarySignerProfile       Json?
  // When the user last opened the Engagement Feed (for time-based "unread")
  engagementLastCheckedAt    DateTime?
  // Use SFS Blastr relay when eligible (paid + plan has enableRelayBlast); default true
  blastrRelayEnabled         Boolean        @default(true)
  // Child/parent self-relation via npub
  isChild                    Boolean        @default(false)
  parentNpub                 String?
  parent                     User?          @relation("UserChildrenByNpub", fields: [parentNpub], references: [npub], onDelete: SetNull)
  children                   User[]         @relation("UserChildrenByNpub")
  pendingParentRequests      String[]       @default([])

  hashTagPresets HashTagPreset[]
  longFormPosts  LongFormPost[]
  Payment        Payment[]
  notes          Post[]
  queueTypes     QueueType[]
  Subscription   Subscription?
  templates      Template[]
  sessions       Session[]
  publishRelayAcks PublishRelayAck[]
  pushSubscriptions PushSubscription[]
  draftVersions      DraftVersion[]
  draftGroups        DraftGroup[]
  draftGroupVersions DraftGroupVersion[]
  media              Media[]
  mediaAssets        MediaAsset[]
  blossomReservationBatches BlossomReservationBatch[]
  blossomUploadUsagePeriods BlossomUploadUsagePeriod[]
  giveaways                Giveaway[]
  giveawayPresets          GiveawayPreset[]
  engagementItemStates     EngagementItemState[]
  engagementReplyTemplates EngagementReplyTemplate[]

  @@index([parentNpub])
}

enum EngagementItemStateKind {
  HANDLED
}

model EngagementItemState {
  id              String                  @id @default(cuid())
  userId          String
  eventId         String
  state           EngagementItemStateKind @default(HANDLED)
  repliedFromApp  Boolean                 @default(false)
  updatedAt       DateTime                @updatedAt
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
}

model EngagementReplyTemplate {
  id        String   @id @default(cuid())
  userId    String
  slug      String
  body      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
  @@index([userId])
}

model LoginChallenge {
  id         String   @id @default(cuid())
  nonce      String
  purpose    String
  expiresAt  DateTime
  consumedAt DateTime?
  pubkey     String?
  createdAt  DateTime @default(now())

  @@index([expiresAt])
  @@index([consumedAt])
  @@index([pubkey])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  pubkey    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([pubkey])
  @@index([expiresAt])
}

model QueueType {
  id              String         @id @default(cuid())
  name            String
  scheduleType    ScheduleType   @default(INTERVAL)
  scheduleConfig  Json
  isEnabled       Boolean        @default(true)
  colorToken      String?
  description     String?
  lastPostTime    DateTime?
  isDefault       Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  userId          String
  hashTagPresetId String?
  longFormPosts   LongFormPost[]
  posts           Post[]
  hashTagPreset   HashTagPreset? @relation(fields: [hashTagPresetId], references: [id])
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model HashTagPreset {
  id            String         @id @default(cuid())
  name          String
  tags          String
  description   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  longFormPosts LongFormPost[]
  posts         Post[]
  queueTypes    QueueType[]

  @@unique([userId, name])
}

enum GiveawayScopeType {
  PERIOD
  SINGLE_POST
  QUEUE
  FOLLOWERS
  FOLLOWING
}

enum GiveawayStatus {
  DRAFT
  PREVIEWED
  LOCKED
  PAID_OUT
  CANCELLED
}

enum GiveawaySelectionMode {
  UNIQUE_USER
  WEIGHTED_BY_ENGAGEMENT
}

model Giveaway {
  id                 String               @id @default(cuid())
  userId             String
  name               String?              // optional human-readable label
  scopeType          GiveawayScopeType
  scopeReference     Json                 // { days?, postId?, queueId?, from?, to? }
  eligibilityFrom    DateTime?
  eligibilityTo      DateTime?
  engagementTypes    Json                 // string[]: REACTION, REPOST, COMMENT, ZAP
  winnerCount        Int                  // total (legacy or sum when engagementConfig set)
  engagementConfig   Json?                // optional: { REACTION: { winnerCount, satsPerWinner }, ... }; when set, per-type winners + sats
  selectionMode      GiveawaySelectionMode @default(UNIQUE_USER)
  engagementWeights  Json?                // { REPOST: 2, COMMENT: 1.5, ... }
  filters            Json?                // { excludeMuted, excludeBlocked, minAccountAgeDays?, minFollowers? }
  status             GiveawayStatus       @default(DRAFT)
  lockedAt           DateTime?
  winnerSnapshot     Json?                // [{ pubkey, npub, qualifyingActions, satsPerWinner?, engagementType? }] at lock
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([userId, createdAt])
}

model GiveawayPreset {
  id                String                 @id @default(cuid())
  userId            String
  name              String
  scopeType         GiveawayScopeType
  scopeReference    Json                   // { days?, postId?, queueId?, from?, to? }
  engagementTypes   Json                   // string[]
  winnerCount       Int
  engagementConfig Json?                  // optional: { REACTION: { winnerCount, satsPerWinner }, ... }
  selectionMode     GiveawaySelectionMode  @default(UNIQUE_USER)
  engagementWeights Json?
  filters           Json?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model Post {
  id                      String                @id @default(cuid())
  nostrEventId            String?
  caption                 String?
  fileUrl                 String[]
  scheduledAtUtc          DateTime? // New DateTime field (UTC)
  nominalScheduledAtUtc   DateTime? // User-chosen time when random window used (for queue "next slot")
  publishedAt             DateTime?
  content                 String?
  postType                PostType              @default(IMAGE)
  repost                  Boolean               @default(false)
  isQuotedPost            Boolean               @default(false)
  isRecyclable            Boolean               @default(false)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  status                  Status                @default(ACTIVE)
  currentState            String                @default("DRAFT") // State machine state - single source of truth
  signedEvent             Json?
  nostrEvent              Json?
  queueTypeId             String?
  tags                    String[]
  manual_override         Boolean               @default(false)
  userId                  String
  hashTagPresetId         String?
  // Idempotency keys
  creationIdempotencyKey  String?               @unique
  enqueueIdempotencyKey   String?               @unique
  publishAttemptId        String?               @unique // First-class idempotency for publish attempts
  // Publish lease (supports safe retries + future multi-worker)
  publishingLockId        String?
  publishingLockExpiresAt DateTime?
  publishingStartedAt     DateTime?
  hashTagPreset           HashTagPreset?        @relation(fields: [hashTagPresetId], references: [id])
  queueType               QueueType?            @relation(fields: [queueTypeId], references: [id])
  template                Template?             @relation("TemplatePost")
  user                    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  stateTransitions        PostStateTransition[]
  // Source post for scheduled repost/quote (multiple reposts/quotes per source allowed)
  repostOfPostId          String?
  repostOf                Post?                 @relation("RepostOf", fields: [repostOfPostId], references: [id])
  reposts                 Post[]                @relation("RepostOf")
  // Optional: only publish repost if source post meets these engagement thresholds (AND)
  repostConditions        Json?                 // { minReactions?, minZaps?, minComments?, minReposts?, minSats? }
  quoteOfPostId           String?
  quoteOf                 Post?                 @relation("QuoteOf", fields: [quoteOfPostId], references: [id])
  quotes                  Post[]                @relation("QuoteOf")
  // Quote of a longform article (kind 1 note referencing kind 30023)
  quoteOfLongFormPostId   String?
  quoteOfLongForm         LongFormPost?          @relation(fields: [quoteOfLongFormPostId], references: [id], onDelete: SetNull)
  // Composer draft metadata (attachment meta, contentWithTokens, threadSegments, alsoScheduleRepost/Quote)
  draftMeta               Json?
  // Thread: links segment posts when created as a thread (schedule-thread / post-thread)
  threadGroupId           String?
  // What is this post? (POST = top-level, THREAD = thread segment, REPLY = reply to event, REPOST/QUOTE = scheduled repost/quote)
  postKind                PostKind               @default(POST)
  // Reply: Nostr event id being replied to (for postKind REPLY)
  replyToEventId          String?
  // Reply: our Post id when the replied-to event is one of our posts
  replyToPostId           String?
  replyTo                 Post?                  @relation("PostReplies", fields: [replyToPostId], references: [id])
  replies                 Post[]                 @relation("PostReplies")
  draftVersions           DraftVersion[]
  draftGroupId            String?
  draftGroup              DraftGroup?  @relation(fields: [draftGroupId], references: [id], onDelete: SetNull)

  // Indexes for common query patterns
  // State machine indexes (use currentState as single source of truth)
  @@index([userId, currentState])
  @@index([currentState, scheduledAtUtc])
  @@index([userId, currentState, scheduledAtUtc])
  @@index([userId, scheduledAtUtc])
  @@index([repostOfPostId])
  @@index([quoteOfPostId])
  @@index([quoteOfLongFormPostId])
  @@index([replyToPostId])
  @@index([draftGroupId])
}

enum PostKind {
  POST
  THREAD
  REPLY
  REPOST
  QUOTE
}

model LongFormPost {
  id                      String                        @id @default(cuid())
  nostrEventId            String?
  title                   String?
  summary                 String?
  content                 String?
  image                   String?
  scheduledAtUtc          DateTime? // New DateTime field (UTC)
  nominalScheduledAtUtc   DateTime? // User-chosen time when random window used (for queue "next slot")
  postedAt                DateTime?
  publishedAt             DateTime?
  updatedAt               DateTime                      @updatedAt
  createdAt               DateTime                      @default(now())
  status                  Status                        @default(DRAFT)
  currentState            String                        @default("DRAFT") // State machine state - single source of truth
  queueTypeId             String?
  tags                    String[]
  signedEvent             Json?
  nostrEvent              Json?
  userId                  String
  hashTagPresetId         String?
  // Idempotency keys
  creationIdempotencyKey  String?                       @unique
  enqueueIdempotencyKey   String?                       @unique
  publishAttemptId        String?                       @unique // First-class idempotency for publish attempts
  // Publish lease (supports safe retries + future multi-worker)
  publishingLockId        String?
  publishingLockExpiresAt DateTime?
  publishingStartedAt     DateTime?
  hashTagPreset           HashTagPreset?                @relation(fields: [hashTagPresetId], references: [id])
  queueType               QueueType?                    @relation(fields: [queueTypeId], references: [id])
  user                    User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  stateTransitions        LongFormPostStateTransition[]
  // Kind 1 quote posts that reference this longform
  quotesFromLongform      Post[]
  draftVersions           DraftVersion[]
  template                Template?

  // Indexes for common query patterns
  // State machine indexes (use currentState as single source of truth)
  @@index([userId, currentState])
  @@index([currentState, scheduledAtUtc])
  @@index([userId, currentState, scheduledAtUtc])
  @@index([userId, scheduledAtUtc])
}

model DraftVersion {
  id                 String         @id @default(cuid())
  postId             String?
  longFormPostId     String?
  version            Int
  snapshot           Json?          // Short post: full snapshot JSON
  snapshotCompressed Bytes?         // Longform: gzipped JSON
  createdAt          DateTime      @default(now())
  createdBy          String?
  post               Post?          @relation(fields: [postId], references: [id], onDelete: Cascade)
  longFormPost       LongFormPost?  @relation(fields: [longFormPostId], references: [id], onDelete: Cascade)
  createdByUser      User?          @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([postId, version])
  @@index([longFormPostId, version])
}

model DraftGroup {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts     Post[]
  versions  DraftGroupVersion[]

  @@index([userId])
}

model DraftGroupVersion {
  id           String    @id @default(cuid())
  draftGroupId String
  version      Int
  snapshot     Json      // Array of { caption, fileUrl, queueTypeId, scheduledFor, sortOrder, ... }
  createdAt    DateTime  @default(now())
  createdBy    String?
  draftGroup   DraftGroup @relation(fields: [draftGroupId], references: [id], onDelete: Cascade)
  createdByUser User?     @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([draftGroupId, version])
}

enum TemplateType {
  POST
  LONGFORM
}

model Template {
  id              String        @id @default(cuid())
  name            String?
  templateType    TemplateType  @default(POST)
  postId          String?       @unique
  post            Post?         @relation("TemplatePost", fields: [postId], references: [id], onDelete: Cascade)
  longFormPostId  String?       @unique
  longFormPost    LongFormPost? @relation(fields: [longFormPostId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id             String        @id
  userId         String
  amount         Int
  amountUsd      Decimal?
  invoice        String
  paymentHash    String
  preimage       String?
  status         PaymentStatus @default(PENDING)
  description    String?
  subscriptionId String?
  expiresAt      DateTime?
  paidAt         DateTime?
  failedAt       DateTime?
  failureReason  String?
  paymentMethod  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  Subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  User           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Plan {
  id                           String         @id
  name                         String
  price                        Decimal
  description                  String?
  features                     Json
  maxPostsPerMonth             Int?
  maxQueueTypes                Int?
  maxTemplates                 Int?
  maxLongFormPosts             Int?
  isActive                     Boolean        @default(true)
  createdAt                    DateTime       @default(now())
  updatedAt                    DateTime       @updatedAt
  enableAdvancedAnalytics      Boolean        @default(false)
  enableBasicScheduling        Boolean        @default(false)
  enableBulkScheduling         Boolean        @default(false)
  enableCommissions            Boolean        @default(false)
  enableEngagementFeed         Boolean        @default(false)
  enableGiveaways              Boolean        @default(false)
  enableLeaderboards           Boolean        @default(false)
  enableLifetimeAccess         Boolean        @default(false)
  enableMultiAccountSwitching  Boolean        @default(false)
  enableMultipleQueues         Boolean        @default(false)
  enableNativeS3BlossomStorage Boolean        @default(false)
  enableRelayBlast             Boolean        @default(false)
  enableRepostsAndQuotes       Boolean        @default(false)
  enableVisualPerks            Boolean        @default(false)
  enableWolfFilteringAndVortex Boolean        @default(false)
  Subscription                 Subscription[]
}

model Subscription {
  id                 String             @id
  userId             String             @unique
  planId             String?
  status             SubscriptionStatus @default(INACTIVE)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  endDate            DateTime?
  lastPaymentDate    DateTime?
  metadata           Json?
  nextPaymentDue     DateTime?
  plan               String?
  startDate          DateTime
  amountSats         BigInt?
  amountUsd          Decimal?
  Payment            Payment[]
  Plan               Plan?              @relation(fields: [planId], references: [id])
  User               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum PostType {
  IMAGE
  CAROUSEL
  TEXT
  VIDEO
}

enum ScheduleType {
  INTERVAL
  FIXED_SLOTS
  WEEKLY_SLOTS
}

enum Status {
  DRAFT
  ACTIVE
  SCHEDULED
  PAUSED
  POSTED
  FAILED
}

enum UploadProvider {
  S3
  BLOSSOM_PRIMAL
  BLOSSOM_BLOSSTR
  BLOSSOM_SFS
  BLOSSOM_CUSTOM
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
  CANCELED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  UNPAID
  TRIALING
  INACTIVE
}

enum PublishRelayAckStatus {
  ACCEPTED
  FAILED
  TIMEOUT
}

// Outbox pattern for transactional job enqueueing
model OutboxEvent {
  id             String    @id @default(cuid())
  eventType      String // "POST_SCHEDULED", "LONGFORM_SCHEDULED", "POST_CANCELLED", etc.
  aggregateId    String // postId or longFormPostId
  aggregateType  String // "Post" or "LongFormPost"
  payload        Json // Job payload data
  scheduledFor   DateTime? // When job should run (UTC)
  idempotencyKey String?   @unique
  correlationId  String? // For request tracking and observability

  // Processing lifecycle
  processedAt     DateTime?
  processingError String? // Back-compat: last error seen while processing (even if retried)

  // Retry metadata (outbox is retryable; events are only marked processed on success)
  attempts       Int       @default(0)
  lastAttemptAt  DateTime?
  nextAttemptAt  DateTime?
  lastError      String?
  deadLetteredAt DateTime?

  // Concurrency guard for multi-worker deployments
  processingLockId        String?
  processingLockExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Prevent duplicate events for same aggregate + event type + scheduled time
  @@unique([eventType, aggregateId, scheduledFor])
  @@index([eventType, processedAt])
  @@index([scheduledFor, processedAt])
  @@index([aggregateId, eventType])
  @@index([correlationId]) // For tracing requests
  @@index([processedAt, nextAttemptAt])
  @@index([deadLetteredAt])
  @@index([processingLockExpiresAt])
}

// State machine for post lifecycle
model PostStateTransition {
  id        String   @id @default(cuid())
  postId    String
  fromState String
  toState   String
  reason    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

// State machine for longform post lifecycle
model LongFormPostStateTransition {
  id             String       @id @default(cuid())
  longFormPostId String
  fromState      String
  toState        String
  reason         String
  createdAt      DateTime     @default(now())
  longFormPost   LongFormPost @relation(fields: [longFormPostId], references: [id], onDelete: Cascade)

  @@index([longFormPostId, createdAt])
}

// Per-relay publish outcomes (execution observability), keyed by publish attempt.
model PublishRelayAck {
  id              String                @id @default(cuid())
  publishAttemptId String
  userId          String
  eventId         String
  relayUrl        String
  status          PublishRelayAckStatus
  receivedAt      DateTime?
  createdAt       DateTime              @default(now())

  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([publishAttemptId, relayUrl])
  @@index([userId, relayUrl, createdAt])
  @@index([eventId, createdAt])
}

model DeadLetterJob {
  id            String   @id @default(cuid())
  queueType     String // "scheduled-posts", "scheduled-longform-posts", etc.
  jobId         String // Original BullMQ job ID
  jobName       String // Job name (e.g., "publish-post")
  jobData       Json // Original job data
  error         String // Error message
  errorStack    String? // Error stack trace
  attemptsMade  Int // Number of attempts before failure
  correlationId String? // Correlation ID for tracing
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([queueType, createdAt])
  @@index([correlationId])
  @@index([jobId])
}

// ============================================================================
// Read Models (Lightweight CQRS)
// ============================================================================

// Denormalized read model for scheduled posts dashboard
model ScheduledPostRead {
  id              String   @id
  userId          String
  postId          String   @unique
  caption         String?
  scheduledAtUtc  DateTime
  queueTypeName      String
  queueTypeColorToken String?
  hashTagPresetId    String?
  templateId         String?
  createdAt          DateTime
  updatedAt          DateTime

  @@index([userId, scheduledAtUtc])
  @@index([userId, queueTypeName])
  @@index([scheduledAtUtc])
}

// Denormalized read model for published posts dashboard
model PublishedPostRead {
  id              String   @id
  userId          String
  postId          String   @unique
  caption         String?
  publishedAt     DateTime
  queueTypeName       String
  queueTypeColorToken String?
  engagementScore     Int? // Pre-computed engagement (can be updated later)
  createdAt           DateTime
  updatedAt           DateTime

  @@index([userId, publishedAt])
  @@index([userId, queueTypeName])
  @@index([userId, publishedAt, engagementScore])
  @@index([publishedAt])
}

// Analytics rollup table (daily aggregations)
model PostAnalyticsDaily {
  id             String   @id @default(cuid())
  userId         String
  date           DateTime @db.Date
  postsScheduled Int      @default(0)
  postsPublished Int      @default(0)
  postsFailed    Int      @default(0)
  avgEngagement  Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
  @@index([date])
}

// Push notification subscriptions for PWA
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Media metadata for Blossom (and other) uploads; SmartFlow owns metadata, Blossom owns storage
model Media {
  id        String   @id @default(cuid())
  userId    String
  url       String
  sha256    String?
  size      Int?
  mimeType  String?
  provider  String   // e.g. BLOSSOM_SFS
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([provider])
  @@index([createdAt])
}

enum MediaAssetStatus {
  uploaded
  processing
  ready
  failed
}

enum MediaVariantStatus {
  pending
  ready
  failed
}

model MediaAsset {
  id              String           @id @default(cuid())
  userId          String
  sha256          String?
  sourceMimeType  String
  sourceBytes     Int
  sourceProvider  String
  status          MediaAssetStatus @default(uploaded)
  errorReason     String?
  lastProcessedAt DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  variants        MediaVariant[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([sha256])
  @@unique([userId, sha256])
}

model MediaVariant {
  id          String             @id @default(cuid())
  assetId     String
  variantKind String
  mimeType    String
  bytes       Int
  width       Int?
  height      Int?
  durationMs  Int?
  url         String
  provider    String
  isPrimary   Boolean            @default(false)
  status      MediaVariantStatus @default(pending)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  asset       MediaAsset         @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, variantKind])
  @@index([provider, status])
  @@unique([assetId, variantKind, provider, url])
}

enum ReservationStatus {
  RESERVED
  COMMITTED
  EXPIRED
  CANCELED
}

enum ReservationBatchStatus {
  ACTIVE
  EXPIRED
  CANCELED
}

model BlossomReservationBatch {
  id         String                 @id @default(cuid())
  batchId    String                 @unique
  userId     String
  pubkey     String
  totalBytes BigInt
  expiresAt  DateTime
  status     ReservationBatchStatus @default(ACTIVE)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      BlossomReservationItem[]

  @@index([userId, status, expiresAt])
  @@index([pubkey, status, expiresAt])
  @@index([expiresAt, status])
}

model BlossomReservationItem {
  id        String            @id @default(cuid())
  jti       String            @unique
  batchId   String
  pubkey    String
  sha256    String
  size      Int
  mimeType  String?
  expiresAt DateTime
  status    ReservationStatus @default(RESERVED)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  batch     BlossomReservationBatch @relation(fields: [batchId], references: [batchId], onDelete: Cascade)

  @@index([batchId, status])
  @@index([pubkey, status, expiresAt])
  @@index([sha256])
  @@index([expiresAt, status])
}

model BlossomCommit {
  id        String   @id @default(cuid())
  jti       String   @unique
  batchId   String?
  pubkey    String
  sha256    String
  size      Int
  mimeType  String?
  url       String
  createdAt DateTime @default(now())

  @@index([pubkey, createdAt])
  @@index([batchId])
}

model BlossomUploadUsagePeriod {
  id             String   @id @default(cuid())
  userId         String
  periodStartUtc DateTime @db.Date
  uploadedBytes  BigInt   @default(0)
  uploadedFiles  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodStartUtc])
  @@index([periodStartUtc])
}

// ---------------------------------------------------------------------------
// Referral system (operator-aligned revenue sharing)
// ---------------------------------------------------------------------------

model Referral {
  referrerNpub  String   @map("referrer_npub")
  referredNpub  String   @id @map("referred_npub")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([referrerNpub])
}

enum ReferralEarningStatus {
  PENDING
  PAID
  FAILED
}

model ReferralEarning {
  id                    String               @id @default(cuid())
  referrerNpub           String               @map("referrer_npub")
  referredNpub           String               @map("referred_npub")
  paymentId             String               @map("payment_id")
  amountPaidSats        Int                  @map("amount_paid_sats")
  commissionSats        Int                  @map("commission_sats")
  status                ReferralEarningStatus @default(PENDING)
  payoutAttemptCount    Int                  @default(0) @map("payout_attempt_count")
  payoutFailureReason   String?              @map("payout_failure_reason")
  createdAt             DateTime             @default(now()) @map("created_at")
  paidAt                DateTime?            @map("paid_at")

  @@unique([referrerNpub, paymentId])
  @@index([referrerNpub])
  @@index([status])
}

model ReferrerPayoutConfig {
  referrerNpub           String   @id @map("referrer_npub")
  payoutDestination      String   @map("payout_destination")
  payoutDestinationType  String?  @map("payout_destination_type") // ln_address | lnurl | invoice_on_demand
  updatedAt              DateTime @updatedAt @map("updated_at")
}
