{
  "name": "smartflow-social",
  "version": "1.0.0",
  "description": "Professional Nostr social media management platform - Schedule, manage, and optimize your decentralized social presence",
  "author": "SmartFlowSocial Team",
  "license": "ELv2",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/xdzczk/SmartFlowSocial.git"
  },
  "homepage": "https://smartflow.social",
  "bugs": {
    "url": "https://github.com/xdzczk/SmartFlowSocial/issues"
  },
  "keywords": [
    "nostr",
    "social-media",
    "remix",
    "typescript",
    "lightning",
    "bitcoin",
    "scheduling",
    "content-management",
    "decentralized",
    "web3"
  ],
  "packageManager": "pnpm@10.27.0",
  "sideEffects": [
    "**/*.css",
    "**/*.server.ts",
    "**/*.server.tsx",
    "app/lib/error-handler.server.ts",
    "@js-temporal/polyfill"
  ],
  "scripts": {
    "postinstall": "prisma generate",
    "prepare": "husky",
    "build": "remix build && esbuild --platform=node --format=cjs ./server.ts --outdir=build --bundle --external:fsevents --external:file-type --external:@prisma/client --external:@prisma/engines && esbuild --platform=node --format=cjs ./worker.ts --outdir=build --bundle --external:fsevents --external:file-type --external:@prisma/client --external:@prisma/engines && tsx scripts/verify-css-build.ts",
    "dev": "npm-run-all2 --parallel dev:*",
    "dev:remix": "remix dev --manual -c \"node --watch-path ./build/server.js --watch ./build/server.js\"",
    "dev:server": "cross-env NODE_ENV=development E2E_TEST=${E2E_TEST:-} esbuild --platform=node --format=cjs ./server.ts --outdir=build --bundle --external:fsevents --external:file-type --external:@prisma/client --external:@prisma/engines --watch",
    "dev:worker": "cross-env NODE_ENV=development esbuild --platform=node --format=cjs ./worker.ts --outdir=build --bundle --external:fsevents --external:ioredis --external:file-type --external:@prisma/client --external:@prisma/engines --watch",
    "docker": "docker compose up -d",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .; LINT_EXIT=$?; eslint --format json . > eslint-report.json 2>&1; exit $LINT_EXIT",
    "lint:ci": "eslint . --format json --output-file eslint-report.json || exit 1",
    "start": "cross-env NODE_ENV=production node ./build/server.js & cross-env NODE_ENV=production node ./build/worker.js & wait",
    "start:server": "cross-env NODE_ENV=production node ./build/server.js",
    "start:worker": "cross-env NODE_ENV=production node ./build/worker.js",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:coverage:report": "pnpm test:coverage && node scripts/coverage-trend.js record",
    "test:coverage:trend": "node scripts/coverage-trend.js report",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:property": "vitest run tests/property",
    "test:performance": "vitest run tests/performance",
    "test:performance:all": "pnpm test:performance && echo '\n✅ Unit performance tests passed!\n\n📝 To run k6 load tests:\n   k6 run tests/performance/api-endpoints.js\n   k6 run tests/performance/bulk-operations.js\n   k6 run tests/performance/loader-performance.js'",
    "test:security": "vitest run tests/security",
    "test:db": "vitest run tests/integration -- --grep 'database'",
    "test:db:setup": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-$DATABASE_URL} pnpm exec prisma migrate deploy || TEST_DATABASE_URL=${TEST_DATABASE_URL:-$DATABASE_URL} pnpm exec prisma db push --accept-data-loss",
    "test:db:seed": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-$DATABASE_URL} tsx tests/database/seed-test-db.ts",
    "test:all": "pnpm test && echo '\n✅ Vitest tests passed!\n\n📝 To run Cypress E2E tests:\n   1. Start dev server: pnpm dev\n   2. In another terminal: pnpm test:e2e\n\n   Or use: pnpm test:e2e:dev (starts server + opens Cypress UI)'",
    "test:e2e": "E2E_TEST=true cypress run",
    "test:e2e:open": "E2E_TEST=true cypress open",
    "test:e2e:dev": "start-server-and-test \"cross-env E2E_TEST=true pnpm dev\" http://localhost:3000 \"E2E_TEST=true pnpm exec cypress open\"",
    "test:e2e:run": "start-server-and-test \"cross-env E2E_TEST=true pnpm dev\" http://localhost:3000 \"E2E_TEST=true cypress run\"",
    "test:loaders": "cypress run --spec \"tests/e2e/loaders/**/*.cy.ts\"",
    "typecheck": "./scripts/typecheck.sh",
    "precheck": "pnpm lint && pnpm exec tsc --noEmit",
    "validate": "pnpm format:check && pnpm lint:ci && pnpm typecheck",
    "clean": "rm -rf build .remix node_modules/.cache coverage .tsbuildinfo",
    "lint:fix": "node scripts/fix-eslint-errors.js"
  },
  "eslintIgnore": [
    "/node_modules",
    "/build",
    "/public/build",
    "/postgres-data"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.965.0",
    "@editorjs/code": "^2.9.4",
    "@editorjs/editorjs": "^2.31.0",
    "@editorjs/embed": "^2.8.0",
    "@editorjs/header": "^2.8.8",
    "@editorjs/image": "^2.10.3",
    "@editorjs/inline-code": "^1.5.2",
    "@editorjs/link": "^2.6.2",
    "@editorjs/list": "^2.0.9",
    "@editorjs/quote": "^2.7.6",
    "@gandlaf21/bolt11-decode": "^3.1.1",
    "@getalby/sdk": "^7.0.0",
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.2.2",
    "@js-temporal/polyfill": "^0.5.1",
    "@nostr-dev-kit/ndk": "^2.18.1",
    "@nostrify/nostrify": "^0.48.2",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@remix-run/css-bundle": "^2.17.3",
    "@remix-run/express": "^2.17.3",
    "@remix-run/node": "^2.17.3",
    "@remix-run/react": "^2.17.3",
    "@sentry/remix": "^10.32.1",
    "@tanstack/react-query": "^5.90.16",
    "@tanstack/react-query-devtools": "^5.91.2",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "browser-image-compression": "^2.0.2",
    "bullmq": "^5.66.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cross-env": "^10.1.0",
    "date-fns": "^4.1.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "file-type": "^21.3.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.0",
    "ipaddr.js": "^2.3.0",
    "isbot": "^5.1.32",
    "lucide-react": "^0.562.0",
    "marked": "^17.0.1",
    "morgan": "^1.10.1",
    "nostr-fetch": "^0.17.0",
    "nostr-relaypool": "^0.6.30",
    "nostr-tools": "^2.19.4",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    "rate-limiter-flexible": "^9.0.1",
    "react": "^18.3.1",
    "react-datepicker": "^9.1.0",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.70.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.5.0",
    "react-qr-code": "^2.0.18",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.34.5",
    "source-map-support": "^0.5.21",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "tiny-invariant": "^1.3.3",
    "uuid": "^13.0.0",
    "ws": "^8.19.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@faker-js/faker": "^10.2.0",
    "@remix-run/dev": "^2.17.3",
    "@remix-run/testing": "^2.17.3",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/cypress": "^10.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie": "^1.0.0",
    "@types/eslint": "^9.6.1",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.0",
    "@types/source-map-support": "^0.5.10",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "autoprefixer": "^10.4.23",
    "chokidar": "^5.0.0",
    "cookie": "^1.1.1",
    "cypress": "^15.8.2",
    "dotenv": "^17.2.3",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-cypress": "^5.2.1",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.12.1",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-secrets": "^2.2.1",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "eslint-plugin-testing-library": "^7.15.4",
    "eslint-plugin-unicorn": "^62.0.0",
    "fast-check": "^4.5.3",
    "globals": "^17.0.0",
    "happy-dom": "^20.1.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.2.7",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.5.6",
    "postcss-nesting": "^13.0.2",
    "prettier": "3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "prisma": "7.2.0",
    "start-server-and-test": "^2.1.3",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.0.3",
    "vitest": "^4.0.16"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "sharp",
      "cypress",
      "esbuild",
      "@sentry/cli"
    ],
    "ignoredBuiltDependencies": [
      "bufferutil",
      "utf-8-validate",
      "msgpackr-extract",
      "unrs-resolver"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "nostr-tools": "^2.17.0",
        "express": "5"
      },
      "ignoreMissing": [],
      "allowedAnyPeerVersion": [
        "nostr-tools"
      ]
    }
  }
}
