{
  "name": "smartflow-social",
  "private": true,
  "sideEffects": false,
  "scripts": {
    "build": "remix build && esbuild --platform=node --format=cjs ./server.ts --outdir=build --bundle --external:fsevents && esbuild --platform=node --format=cjs ./worker.ts --outdir=build --bundle --external:fsevents",
    "dev": "npm-run-all2 --parallel dev:*",
    "dev:remix": "remix dev --manual -c \"node --watch-path ./build/server.js --watch ./build/server.js\"",
    "dev:server": "cross-env NODE_ENV=development esbuild --platform=node --format=cjs ./server.ts --outdir=build --bundle --external:fsevents --watch",
    "dev:worker": "cross-env NODE_ENV=development esbuild --platform=node --format=cjs ./worker.ts --outdir=build --bundle --external:fsevents --external:ioredis --watch",
    "docker": "docker compose up -d",
    "format": "prettier --write .",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .; LINT_EXIT=$?; eslint --format json . > eslint-report.json 2>&1; exit $LINT_EXIT",
    "start": "cross-env NODE_ENV=production node ./build/server.js",
    "start:worker": "cross-env NODE_ENV=production node ./build/worker.js",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:coverage:report": "pnpm test:coverage && node scripts/coverage-trend.js record",
    "test:coverage:trend": "node scripts/coverage-trend.js report",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:property": "vitest run tests/property",
    "test:performance": "vitest run tests/performance",
    "test:performance:all": "pnpm test:performance && echo '\n✅ Unit performance tests passed!\n\n📝 To run k6 load tests:\n   k6 run tests/performance/api-endpoints.js\n   k6 run tests/performance/bulk-operations.js\n   k6 run tests/performance/loader-performance.js'",
    "test:security": "vitest run tests/security",
    "test:db": "vitest run tests/integration -- --grep 'database'",
    "test:db:setup": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-$DATABASE_URL} pnpm exec prisma migrate deploy",
    "test:db:seed": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-$DATABASE_URL} tsx tests/database/seed-test-db.ts",
    "test:all": "pnpm test && echo '\n✅ Vitest tests passed!\n\n📝 To run Cypress E2E tests:\n   1. Start dev server: pnpm dev\n   2. In another terminal: pnpm test:e2e\n\n   Or use: pnpm test:e2e:dev (starts server + opens Cypress UI)'",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "test:e2e:dev": "start-server-and-test dev http://localhost:3000 \"pnpm exec cypress open\"",
    "test:e2e:run": "start-server-and-test dev http://localhost:3000 \"cypress run\"",
    "test:loaders": "cypress run --spec \"tests/e2e/loaders/**/*.cy.ts\"",
    "typecheck": "bash -c 'ERRORS=$(tsc 2>&1 | grep -v \"node_modules\"); echo \"$ERRORS\"; echo \"$ERRORS\" | grep -q \"error TS\" && exit 1 || exit 0' && bash -c 'ERRORS=$(tsc -p tests/e2e 2>&1 | grep -v \"node_modules\"); echo \"$ERRORS\"; echo \"$ERRORS\" | grep -q \"error TS\" && exit 1 || exit 0'",
    "precheck": "pnpm lint && pnpm exec tsc --noEmit",
    "lint:fix": "node scripts/fix-eslint-errors.js",
    "git:status": "git status",
    "git:push": "git push",
    "git:sync": "git add . && git commit -m \"Update\" && git push"
  },
  "eslintIgnore": [
    "/node_modules",
    "/build",
    "/public/build",
    "/postgres-data"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.701.0",
    "@editorjs/code": "^2.9.3",
    "@editorjs/editorjs": "^2.31.0",
    "@editorjs/embed": "^2.7.6",
    "@editorjs/header": "^2.8.8",
    "@editorjs/image": "^2.10.3",
    "@editorjs/inline-code": "^1.5.2",
    "@editorjs/link": "^2.6.2",
    "@editorjs/list": "^2.0.8",
    "@editorjs/quote": "^2.7.6",
    "@gandlaf21/bolt11-decode": "^3.1.1",
    "@getalby/sdk": "^6.0.2",
    "@headlessui/react": "^2.2.0",
    "@heroicons/react": "^2.2.0",
    "@nostr-dev-kit/ndk": "^2.12.2",
    "@nostrify/nostrify": "^0.48.2",
    "@prisma/client": "^6.15.0",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.12",
    "@remix-run/css-bundle": "^2.14.0",
    "@remix-run/express": "^2.14.0",
    "@remix-run/node": "^2.14.0",
    "@remix-run/react": "^2.14.0",
    "@sentry/remix": "^8.55.0",
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "browser-image-compression": "^2.0.2",
    "bullmq": "^5.56.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.7.4",
    "cross-env": "^7.0.3",
    "date-fns": "^4.1.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "isbot": "^5.1.17",
    "lucide-react": "^0.533.0",
    "marked": "^4.3.0",
    "morgan": "^1.10.0",
    "nostr-fetch": "^0.17.0",
    "nostr-login": "^1.7.0",
    "nostr-relaypool": "^0.6.30",
    "nostr-tools": "^2.17.2",
    "prom-client": "^15.1.3",
    "rate-limiter-flexible": "^9.0.1",
    "react": "^18.3.1",
    "react-datepicker": "^7.5.0",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.5.1",
    "react-icons": "^5.5.0",
    "sharp": "^0.34.3",
    "source-map-support": "^0.5.21",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "tiny-invariant": "^1.3.3",
    "uuid": "^11.0.3",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.0.3",
    "@remix-run/dev": "^2.14.0",
    "@remix-run/testing": "^2.14.0",
    "@testing-library/cypress": "^10.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie": "^0.6.0",
    "@types/eslint": "^8.56.12",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/source-map-support": "^0.5.10",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "globals": "^15.14.0",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "autoprefixer": "^10.4.20",
    "cookie": "^0.6.0",
    "cypress": "^15.7.1",
    "dotenv": "^16.6.1",
    "esbuild": "^0.24.0",
    "eslint": "^9.18.0",
    "@eslint/js": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-cypress": "^4.3.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.8.3",
    "eslint-plugin-jest-dom": "^5.4.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-testing-library": "^7.0.0",
    "fast-check": "^3.22.0",
    "chokidar": "^3.6.0",
    "happy-dom": "^20.0.11",
    "jsdom": "^27.3.0",
    "npm-run-all2": "^6.2.3",
    "postcss": "^8.4.47",
    "prettier": "3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "prisma": "^6.15.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "sharp",
      "cypress",
      "esbuild",
      "@sentry/cli"
    ],
    "ignoredBuiltDependencies": [
      "bufferutil",
      "utf-8-validate",
      "msgpackr-extract",
      "unrs-resolver"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "nostr-tools": "^2.17.0"
      },
      "ignoreMissing": [],
      "allowedAnyPeerVersion": [
        "nostr-tools"
      ]
    }
  }
}
